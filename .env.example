NODE_ENV=development
PORT=3001
MONGODB_URI=mongodb://localhost:27017/pethealth_vet_dev
JWT_SECRET=
JWT_EXPIRES_IN=7d
# Owner backend GraphQL URL for service-to-service patient data (backend only)
OWNER_GRAPHQL_URL=http://localhost:3000/graphql
# Must match OWNER_SERVICE_SECRET in pethealth-backend
OWNER_SERVICE_SECRET=dev-owner-service-secret-change-me
# Optional; defaults to the vet frontend (localhost:5174) in development
# CORS_ORIGIN=http://localhost:5174,http://127.0.0.1:5174
