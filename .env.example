NODE_ENV=development
PORT=3001
MONGODB_URI=mongodb://localhost:27017/pethealth_vet_dev
# Development only — use 32+ random characters in production
JWT_SECRET=dev-vet-jwt-secret-change-me-in-production
JWT_EXPIRES_IN=7d
# Owner backend GraphQL URL for service-to-service patient data (backend only)
OWNER_GRAPHQL_URL=http://localhost:3000/graphql
# Must match OWNER_SERVICE_SECRET in pethealth-backend
OWNER_SERVICE_SECRET=dev-owner-service-secret-change-me
# Optional; defaults to the vet frontend (localhost:5174) in development
# CORS_ORIGIN=http://localhost:5174,http://127.0.0.1:5174

# Clinic app URL used in team invitation links
VET_FRONTEND_URL=http://localhost:5174
# Optional: send team invitation emails with Resend. Without these, the
# invitation link is printed in the API log (development) and shown to the admin.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
